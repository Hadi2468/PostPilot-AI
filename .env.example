# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Required --------------------------------------------------------
OPENAI_API_KEY=
TAVILY_API_KEY=

# --- Optional: LangSmith tracing -------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=postpilot-ai

# --- App settings (defaults shown) -----------------------------------
POSTPILOT_OPENAI_MODEL=gpt-4o-mini
POSTPILOT_SCORE_THRESHOLD=8.5
POSTPILOT_MIN_FAITHFULNESS=7.0
POSTPILOT_MAX_ITERATIONS=3
POSTPILOT_HUMAN_REVIEW=true

# API auth: when set, requests need "Authorization: Bearer <token>"
POSTPILOT_API_TOKEN=
# Where the Streamlit dashboard finds the API
POSTPILOT_API_URL=http://localhost:8000
